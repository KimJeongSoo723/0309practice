# --- 네트워크 ---
# mainnet 또는 testnet
NETWORK=mainnet

# WSS 엔드포인트 (속도가 생명 - QuickNode/Ankr/Chainstack 유료 권장).
# mainnet 예시: wss://bsc-rpc.publicnode.com
# testnet 예시: wss://bsc-testnet-rpc.publicnode.com
BSC_WSS_URL=wss://bsc-rpc.publicnode.com
BSC_HTTP_URL=https://bsc-dataseed.binance.org

# --- 실행 모드 ---
# true 로 두면 실제 트랜잭션을 보내지 않고 eth_call 시뮬레이션만 수행.
# 처음 실행할 땐 true 권장.
DRY_RUN=true

# --- 지갑 ---
# 0x 포함 64자리. 절대 깃에 커밋 금지.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# --- 매수 대상 ---
# 스나이핑할 토큰 컨트랙트 주소 (체크섬 형식 권장)
TARGET_TOKEN=0xTARGET_TOKEN_ADDRESS
TARGET_TOKEN_DECIMALS=18

# --- 매수 파라미터 ---
# 1회 매수에 쓸 BNB 양 (string 그대로)
AMOUNT_IN_BNB=0.05

# 가격 상한: 1 TOKEN = N BNB. 사용자의 0.007 요구사항.
# 즉 풀 가격이 0.007 BNB/TOKEN 보다 비싸면 거래는 revert 됩니다.
MAX_PRICE_BNB_PER_TOKEN=0.007

# --- 가스 ---
# Gwei 단위. 경쟁 환경에선 5~10 gwei 정도가 일반적이지만 상황에 맞춰 올리세요.
GAS_PRICE_GWEI=5
GAS_LIMIT=500000

# 트랜잭션 deadline (현재시각 + N초)
DEADLINE_SECONDS=60

# =========================================================
#  매도(SELL) 봇 설정 — `npm run sell`
#  시작 시 보유 물량을 100등분해서 네이티브 BNB 로 반복 매도.
#  (TOKEN -> WBNB, swapExactTokensForETH)
# =========================================================

# 매도할 토큰 컨트랙트 주소
TOKEN_TO_SELL=0x4d41A5d412f4Ef44A35b9f53b06DB65edE249493

# 시작 잔액을 몇 등분해서 팔지 (기본 100분할 = 1회당 1/100 매도)
SPLIT_COUNT=100

# 슬리피지 허용치 (bps). 200 = 2%.
SLIPPAGE_BPS=200

# 전송세(fee-on-transfer) 토큰이면 true. 모르면 true 가 안전.
FEE_ON_TRANSFER=true

# 매도 사이 대기 시간(초). 이 구간에서 무작위.
INTERVAL_MIN_SECONDS=30
INTERVAL_MAX_SECONDS=90
