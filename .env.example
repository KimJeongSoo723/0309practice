# --- 네트워크 ---
# 메인넷용 WSS 엔드포인트 (QuickNode, Ankr, Chainstack 등). 속도가 생명이라 유료 권장.
BSC_WSS_URL=wss://bsc-rpc.publicnode.com
BSC_HTTP_URL=https://bsc-dataseed.binance.org

# --- 지갑 ---
# 0x 포함 64자리. 절대 깃에 커밋 금지.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# --- 매수 대상 ---
# 스나이핑할 토큰 컨트랙트 주소 (체크섬 형식 권장)
TARGET_TOKEN=0xTARGET_TOKEN_ADDRESS
TARGET_TOKEN_DECIMALS=18

# --- 매수 파라미터 ---
# 1회 매수에 쓸 BNB 양 (string 그대로)
AMOUNT_IN_BNB=0.05

# 가격 상한: 1 TOKEN = N BNB. 사용자의 0.007 요구사항.
# 즉 풀 가격이 0.007 BNB/TOKEN 보다 비싸면 거래는 revert 됩니다.
MAX_PRICE_BNB_PER_TOKEN=0.007

# --- 가스 ---
# Gwei 단위. 경쟁 환경에선 5~10 gwei 정도가 일반적이지만 상황에 맞춰 올리세요.
GAS_PRICE_GWEI=5
GAS_LIMIT=500000

# 트랜잭션 deadline (현재시각 + N초)
DEADLINE_SECONDS=60
